{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "target": "ESNext",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../web-ai/tsconfig.lib.json"
    },
    {
      "path": "../rainforest-react/tsconfig.lib.json"
    },
    {
      "path": "../library-contract/tsconfig.lib.json"
    },
    {
      "path": "../rainforest-ui/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test-setup.ts",
    "src/**/*.story.tsx"
  ]
}
