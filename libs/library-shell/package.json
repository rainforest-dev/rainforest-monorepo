{
  "name": "@rainforest-dev/library-shell",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind.css": "./dist/tailwind.css",
    "./view-transitions.css": "./dist/view-transitions.css",
    "./_shell/*": "./dist/_shell/*"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "libs/library-shell/src",
    "name": "library-shell",
    "targets": {
      "test": {
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck",
          "^build"
        ]
      }
    }
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "dependencies": {
    "@rainforest-dev/library-contract": "workspace:*",
    "@rainforest-dev/rainforest-react": "workspace:*",
    "lucide-react": "^1.59.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plugin-dts": "~5.1.2",
    "vitest": "5.0.5"
  }
}
