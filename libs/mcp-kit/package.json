{
  "name": "@rainforest-dev/mcp-kit",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    },
    "./tool": {
      "types": "./dist/tool.d.ts",
      "import": "./dist/tool.js",
      "default": "./dist/tool.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "libs/mcp-kit/src",
    "name": "mcp-kit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plugin-dts": "^4.5.4"
  }
}
