{
  "name": "@rainforest-dev/rainforest-ui",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    },
    "./tailwindcss/*": {
      "types": "./dist/tailwindcss/*.d.ts",
      "import": "./dist/tailwindcss/*.js",
      "default": "./dist/tailwindcss/*.cjs"
    },
    "./lit/*": {
      "types": "./dist/lit/*.d.ts",
      "import": "./dist/lit/*.js",
      "default": "./dist/lit/*.cjs"
    },
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "import": "./dist/recipes/index.js",
      "default": "./dist/recipes/index.cjs"
    },
    "./interaction": {
      "types": "./dist/interaction/index.d.ts",
      "import": "./dist/interaction/index.js",
      "default": "./dist/interaction/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@material/material-color-utilities": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "^2.1.1",
    "lit": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:"
  },
  "nx": {
    "sourceRoot": "libs/rainforest-ui/src",
    "name": "rainforest-ui"
  },
  "devDependencies": {
    "@storybook/web-components": "^10.6.1",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-lit": "^2.3.1",
    "glob": "^13.0.6",
    "vite-bundle-analyzer": "^1.3.9"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
