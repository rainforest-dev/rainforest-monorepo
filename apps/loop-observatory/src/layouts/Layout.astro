---
import '@/app.css';

interface Props {
  title?: string;
  description?: string;
  active?: 'overview' | 'decide' | 'tasks' | 'setup';
}

const {
  title = 'Loop Observatory',
  description = 'Autonomous-loop dashboard: usage, budget, machines, loop status and sprint tasks.',
  active,
} = Astro.props;

// One list, two renderings: a text row in the header from `sm` up, and a bottom
// tab bar below it. The four destinations are the same either way -- a phone
// getting a different set of places to go is a different app, not a layout.
//
// `icon` is a path drawn in a 24x24 stroked viewBox, which is what every other
// icon in this file already is. Labels stay on the tabs: four of them fit at
// 390px, and an icon-only bar makes the reader guess.
const navLinks = [
  { key: 'overview', label: 'Overview', href: '/', icon: 'M3 12h4l3 8 4-16 3 8h4' },
  { key: 'decide', label: 'Decide', href: '/decide', icon: 'M20 6 9 17l-5-5' },
  {
    key: 'tasks',
    label: 'Tasks',
    href: '/tasks',
    icon: 'M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01',
  },
  {
    key: 'setup',
    label: 'Setup',
    href: '/setup',
    icon: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z',
  },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Apply the saved theme before paint to avoid a flash. -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('scheme');
          if (s === 'dark' || s === 'light')
            document.documentElement.dataset.scheme = s;
        } catch (e) {}
      })();
    </script>
    <style>
      #theme-toggle .icon-sun,
      #theme-toggle .icon-moon {
        display: none;
      }
      #theme-toggle[data-scheme='light'] .icon-sun {
        display: block;
      }
      #theme-toggle[data-scheme='dark'] .icon-moon {
        display: block;
      }
      @keyframes lo-spin {
        to {
          transform: rotate(360deg);
        }
      }
      #refresh-btn[data-busy] .refresh-icon {
        animation: lo-spin 0.9s linear infinite;
      }
    </style>
  </head>
  <body class="bg-background text-foreground min-h-screen">
    <header
      class="border-border bg-background/80 sticky top-0 z-30 border-b backdrop-blur"
    >
      <div
        class="mx-auto flex max-w-6xl items-center gap-2 px-4 py-3 sm:gap-4 sm:px-6"
      >
        <a href="/" class="flex items-center gap-2">
          <span
            class="inline-block size-2.5 rounded-full"
            style="background-color: var(--status-good)"
            aria-hidden="true"></span>
          <span class="text-foreground font-semibold tracking-tight">
            Loop Observatory
          </span>
        </a>

        <!-- Header nav from `sm` up. Below that it would need 154px this screen
             does not have, which is exactly how much the whole page overflowed
             by at 390px, on every route, before this. -->
        <nav class="ml-2 hidden items-center gap-1 sm:flex" aria-label="Primary">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                aria-current={active === link.key ? 'page' : undefined}
                class:list={[
                  'rounded-md px-3 py-1.5 text-sm font-medium transition-colors',
                  active === link.key
                    ? 'bg-muted text-foreground'
                    : 'text-muted-foreground hover:text-foreground hover:bg-muted/60',
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <div class="ml-auto flex items-center gap-1">
          <span
            id="refresh-status"
            class="text-muted-foreground hidden text-xs sm:inline"
            role="status"
            aria-live="polite"></span>
          <button
            id="refresh-btn"
            type="button"
            aria-label="Refresh data (re-run quota, enrich, task sync)"
            title="Refresh: export quota, enrich ledger, sync tasks"
            class="text-muted-foreground hover:text-foreground hover:bg-muted/60 inline-flex h-9 items-center gap-1.5 rounded-md px-3 text-sm font-medium transition-colors disabled:opacity-60"
          >
            <svg
              class="refresh-icon size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
              <path d="M21 3v6h-6"></path>
            </svg>
            <span class="hidden sm:inline">Refresh</span>
          </button>

          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
            class="text-muted-foreground hover:text-foreground hover:bg-muted/60 inline-flex size-9 items-center justify-center rounded-md transition-colors"
          >
            <svg
              class="icon-sun size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              ></path>
            </svg>
            <svg
              class="icon-moon size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- The bottom bar is fixed, so the last card would sit under it. Its own
         height plus the home-indicator inset, and only while the bar is there. -->
    <main
      class="mx-auto max-w-6xl px-4 py-6 pb-[calc(4.25rem+env(safe-area-inset-bottom))] sm:px-6 sm:py-8 sm:pb-8"
    >
      <slot />
    </main>

    <!-- Phones only. Four destinations, thumb-height, which is where this app is
         actually read: /decide already says "Hold to clear -- one deliberate
         press, no swipes", and that is a sentence written for a phone. -->
    <nav
      class="border-border bg-background/95 fixed inset-x-0 bottom-0 z-40 border-t pb-[env(safe-area-inset-bottom)] backdrop-blur sm:hidden"
      aria-label="Primary"
    >
      <ul class="grid grid-cols-4">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={active === link.key ? 'page' : undefined}
                class:list={[
                  'flex h-[4.25rem] flex-col items-center justify-center gap-1 text-[11px] font-medium transition-colors',
                  active === link.key
                    ? 'text-foreground'
                    : 'text-muted-foreground',
                ]}
              >
                <svg
                  class="size-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={link.icon} />
                </svg>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <script is:inline>
      (function () {
        // Theme toggle — flips data-scheme (both shadcn + chart tokens honor it).
        var btn = document.getElementById('theme-toggle');
        if (btn) {
          var current = function () {
            var ds = document.documentElement.dataset.scheme;
            if (ds === 'dark' || ds === 'light') return ds;
            return window.matchMedia &&
              window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
          };
          var apply = function (s) {
            document.documentElement.dataset.scheme = s;
            btn.dataset.scheme = s;
            try {
              localStorage.setItem('scheme', s);
            } catch (e) {}
          };
          btn.dataset.scheme = current();
          btn.addEventListener('click', function () {
            apply(current() === 'dark' ? 'light' : 'dark');
          });
        }

        // Refresh — POST /api/refresh, then tell the islands to re-fetch.
        var rbtn = document.getElementById('refresh-btn');
        if (rbtn) {
          var busy = false;
          var status = document.getElementById('refresh-status');
          var setStatus = function (message, failed) {
            if (status) {
              status.textContent = message;
              status.style.color = failed ? 'var(--status-critical)' : '';
            }
            rbtn.title = failed
              ? 'Refresh failed — open the server logs'
              : message;
          };
          rbtn.addEventListener('click', async function () {
            if (busy) return;
            busy = true;
            rbtn.dataset.busy = '1';
            rbtn.disabled = true;
            setStatus('Syncing…', false);
            try {
              var response = await fetch('/api/refresh', { method: 'POST' });
              var payload = await response.json().catch(function () {
                return null;
              });
              if (!response.ok || !payload || payload.ok !== true) {
                var failedStep =
                  payload &&
                  payload.steps &&
                  payload.steps.find(function (step) {
                    return step.ok === false;
                  });
                throw new Error(
                  (failedStep && (failedStep.error || failedStep.step)) ||
                    'refresh failed',
                );
              }
              setStatus('Synced just now', false);
            } catch (e) {
              setStatus('Sync failed', true);
            } finally {
              busy = false;
              delete rbtn.dataset.busy;
              rbtn.disabled = false;
              window.dispatchEvent(new CustomEvent('lo:refresh'));
            }
          });
        }
      })();
    </script>
  </body>
</html>
