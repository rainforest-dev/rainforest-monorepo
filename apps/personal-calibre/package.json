{
  "name": "@rainforest-monorepo/personal-calibre",
  "version": "0.0.1",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@rainforest-dev/mcp-kit": "workspace:*",
    "@rainforest-dev/rainforest-react": "workspace:*",
    "@rainforest-dev/rainforest-ui": "workspace:*",
    "@react-three/fiber": "9.8.1",
    "better-sqlite3": "^12.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.2",
    "lucide-react": "^1.8.0",
    "next": "catalog:",
    "oidn-web": "0.4.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanitize-html": "^2.17.5",
    "tailwind-merge": "^3.5.0",
    "three": "0.186.1",
    "three-gpu-pathtracer": "0.0.26",
    "three-mesh-bvh": "0.9.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "0.186.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "nx": {
    "name": "personal-calibre",
    "projectType": "application",
    "sourceRoot": "apps/personal-calibre/src",
    "tags": [
      "docker"
    ],
    "targets": {
      "dev": {
        "options": {
          "port": 8080
        },
        "dependsOn": [
          "^build"
        ]
      },
      "build": {
        "outputs": [
          "{projectRoot}/.next/!(cache)/**/*",
          "{projectRoot}/.next/!(cache)"
        ],
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/personal-calibre",
          "command": "tsc --noEmit -p tsconfig.json"
        },
        "dependsOn": [
          "^build"
        ]
      },
      "build-deps": {
        "executor": "nx:noop",
        "dependsOn": [
          "^build"
        ]
      },
      "bundle": {
        "command": "node tools/app-artifact/bundle.mjs next apps/personal-calibre"
      },
      "smoke-artifact": {
        "command": "node tools/app-artifact/smoke.mjs personal-calibre"
      }
    },
    "release": {
      "docker": {
        "repositoryName": "rainforest-dev/personal-calibre"
      }
    }
  }
}
