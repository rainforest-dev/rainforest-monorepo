---
import { getCollection } from 'astro:content';

import Item from './item.astro';

const { lang = 'en' } = Astro.params;

const experiences = (
  await getCollection('experiences', (item) => {
    const isLangMatch = item.id.startsWith(lang);
    return isLangMatch;
  })
).sort((a, b) => b.data.startAt.getTime() - a.data.startAt.getTime());
---

<Fragment>
  <div class="size-full">
    <ul
      id="experiences"
      class="after:bg-foreground relative flex flex-col gap-4 after:absolute after:left-0 after:h-full after:w-0.5 after:-translate-x-1/2 after:content-[''] sm:gap-5 after:sm:left-1/2"
    >
      {
        experiences.map((experience) => {
          return <Item {...experience} />;
        })
      }
    </ul>
  </div>
</Fragment>
