---
import '@/app.css';

import { SourceColor, ThemeProvider } from '@components';
import CommandPalette from '@components/shell/CommandPalette.vue';
import SiteFooter from '@components/shell/SiteFooter.astro';
import SiteHeader from '@components/shell/SiteHeader.astro';
import {
  getProjects,
  getSkills,
  getWorkExperience,
} from '@rainforest-dev/personal-data';
import { buildPaletteRecords } from '@utils/palette-records';
import type { Searchable } from '@utils/search';
import type { ExpansionFile } from '@utils/search-expansions';
import SpeedInsights from '@vercel/speed-insights/astro';
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import { dir as _dir } from 'i18next';

import searchExpansions from '@/data/search-expansions.json';

import Head from './head.astro';
import type { Props } from './types';

const {
  viewTransition = { enabled: false },
  hideSourceColorPicker = false,
  shell = false,
  forceScheme,
  ...rest
} = Astro.props;

const lang = Astro.currentLocale === 'zh' ? 'zh' : 'en';
const dir = _dir(lang);

// Records for the ⌘K command palette. Fetched on every layout render (not cached) — the
// underlying content-collection reads are already memoized by Astro, and this is a handful of
// arrays, not a database query.
const [experiences, projects, skills, posts] = await Promise.all([
  getWorkExperience({ lang }),
  getProjects({ lang }),
  getSkills({ lang }),
  getCollection('blog'),
]);

const paletteRecords: Searchable[] = buildPaletteRecords({
  experiences,
  projects,
  skills,
  posts,
}).map((record) => ({
  ...record,
  expanded: (searchExpansions as ExpansionFile).records[record.id]?.terms,
}));
---

<!doctype html>
<html lang={lang} dir={dir} data-force-scheme={forceScheme}>
  <Head {...rest}>
    <ThemeProvider server:defer />
    {viewTransition.enabled && <ClientRouter />}
  </Head>
  <body>
    {shell && <SiteHeader />}
    <slot />
    {shell && <SiteFooter />}
    {
      !hideSourceColorPicker && (
        <div class="fixed bottom-10 right-10 z-10 print:hidden">
          <SourceColor client:only="vue" showTheme={!shell} />
        </div>
      )
    }
    <SpeedInsights />
    <script>
      // Cookieless recruiter-conversion tracking (outbound clicks, contact, resume,
      // case-study views) → /api/event → GA4. No cookies, no consent banner.
      import '@/scripts/conversion-tracking';
    </script>
    <!-- client:idle: keyboard-triggered (⌘K), so it needn't hydrate before the page is interactive. -->
    <CommandPalette records={paletteRecords} lang={lang} client:idle />
  </body>
</html>
