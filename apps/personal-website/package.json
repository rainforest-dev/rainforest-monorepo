{
  "name": "personal-website",
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "dev": "astro dev --host=0.0.0.0",
    "preview": "astro preview",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "11.0.11",
    "@astrojs/vue": "7.0.3",
    "@iconify-icon/react": "^3.0.4",
    "@lit/react": "^1.0.8",
    "@lucide/vue": "^1.52.0",
    "@material/material-color-utilities": "catalog:",
    "@mlc-ai/web-llm": "^0.2.85",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@nanostores/lit": "^0.2.3",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "^2.0.1",
    "@nanostores/vue": "^1.1.0",
    "@rainforest-dev/mcp-kit": "workspace:*",
    "@rainforest-dev/personal-data": "workspace:*",
    "@rainforest-dev/personal-portfolio": "workspace:*",
    "@rainforest-dev/rainforest-react": "workspace:*",
    "@rainforest-dev/rainforest-ui": "workspace:*",
    "@rainforest-dev/web-ai": "workspace:*",
    "@sentry/astro": "^11.4.0",
    "@tailwindcss/vite": "catalog:",
    "@vercel/speed-insights": "^2.0.0",
    "@vueuse/core": "^15.0.0",
    "astro": "7.3.5",
    "baseline-status": "^1.2.0",
    "class-variance-authority": "catalog:",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.3",
    "iconify-icon": "^3.0.3",
    "js-cookie": "^3.0.8",
    "katex": "0.19.0",
    "lit": "catalog:",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.14",
    "nanostores": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rehype-katex": "^7.0.1",
    "reka-ui": "^2.10.5",
    "remark-math": "^6.0.0",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "catalog:",
    "@types/dom-chromium-ai": "0.0.17",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vite-pwa/astro": "^1.2.0",
    "@vue/test-utils": "^2.5.1",
    "@webgpu/types": "^0.1.74",
    "astro-compress": "^2.4.3",
    "eslint-plugin-astro": "^3.2.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "typescript": "catalog:",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "nx": {
    "targets": {
      "dev": {
        "dependsOn": [
          "^build"
        ]
      },
      "build": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/.vercel/output"
        ],
        "cache": true
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "cache": true,
        "inputs": [
          "{projectRoot}/src/**/*",
          "{projectRoot}/tsconfig.json",
          "{workspaceRoot}/tsconfig.base.json"
        ],
        "dependsOn": [
          "^build"
        ],
        "options": {
          "command": "astro check",
          "cwd": "{projectRoot}"
        }
      },
      "expand-search-keywords": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "command": "node scripts/expand-search-keywords.ts",
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
