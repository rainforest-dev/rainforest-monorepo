{
  "extends": ["astro/tsconfigs/strict", "../../tsconfig.base.json"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../libs/journal-kit"
    },
    {
      "path": "../../libs/web-ai"
    },
    {
      "path": "../../libs/search"
    },
    {
      "path": "../../libs/rainforest-ui"
    },
    {
      "path": "../../libs/rainforest-react"
    },
    {
      "path": "../../libs/mcp-kit"
    }
  ]
}
