---
import { dayHeading, type MonthCell, thumbUrl } from '@/lib';

import { COVER_BADGE } from './cover-badge.ts';

type Props = {
  date: string;
  detail: string;
  anchor: string;
  cell?: MonthCell | undefined;
};

const { date, detail, anchor, cell } = Astro.props;
---

<span
  data-preview
  popover="hint"
  aria-hidden="true"
  style={`position-anchor: ${anchor}`}
  class="bg-popover text-popover-foreground ring-foreground/10 pointer-events-none z-50 w-56 flex-col gap-1.5 rounded-xl p-3 text-left text-xs shadow-md ring-1"
>
  <span class="font-semibold tabular-nums">{dayHeading(date)}</span>
  <span class="text-muted-foreground">{detail}</span>
  {
    cell?.cover ? (
      <span class="relative mt-1 block">
        <img
          src={thumbUrl(cell.cover, 0, 240)}
          alt=""
          loading="lazy"
          decoding="async"
          class="bg-muted aspect-video w-full rounded-sm object-cover"
        />
        {cell.coverManual && (
          <span class={`${COVER_BADGE} bottom-1 left-1`}>封面</span>
        )}
      </span>
    ) : cell?.memory ? (
      <span class="text-meta line-clamp-2">{cell.memory}</span>
    ) : cell?.excerpt ? (
      <span class="text-meta text-muted-foreground line-clamp-2">
        「{cell.excerpt}」
      </span>
    ) : null
  }
</span>
