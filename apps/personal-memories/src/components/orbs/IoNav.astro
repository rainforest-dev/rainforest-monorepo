---
import { cn } from '@rainforest-dev/rainforest-react';

import { IO_TABS } from '@/lib';

type Props = { pathname: string; dayHref: string };
const { pathname, dayHref } = Astro.props;
---

<nav
  aria-label="Inside Out"
  class="-mx-4 -mt-4 mb-6 flex gap-1 overflow-x-auto px-4 pb-1 [scrollbar-width:none]"
>
  {
    IO_TABS.map((tab) => {
      const active = tab.match.test(pathname);
      return (
        <a
          href={tab.href === '/day' ? dayHref : tab.href}
          aria-current={active ? 'page' : undefined}
          data-io-display
          class={cn(
            'shrink-0 rounded-full px-4 py-1.5 text-sm font-medium transition-colors',
            active
              ? 'bg-primary text-primary-foreground'
              : 'text-muted-foreground hover:bg-muted hover:text-foreground',
          )}
        >
          {tab.label}
        </a>
      );
    })
  }
</nav>
