---
import type { CalendarCell } from '../lib/days.ts';

type Props = {
  weeks: CalendarCell[][];
  level: (total: number) => 0 | 1 | 2 | 3 | 4;
  noted: Set<string>;
};

const { weeks, level, noted } = Astro.props;

const LEVEL = [
  'bg-muted',
  'bg-primary/25',
  'bg-primary/50',
  'bg-primary/75',
  'bg-primary',
];

const WEEKDAY_LABEL: Record<number, string> = { 0: '一', 2: '三', 4: '五' };

const mondayMonth = (week: CalendarCell[]): string | null => {
  for (let i = 0; i < week.length; i++) {
    const cell = week[i];
    if (cell) {
      const ms = Date.parse(`${cell.date}T00:00:00Z`) - i * 86_400_000;
      return new Date(ms).toISOString().slice(0, 7);
    }
  }
  return null;
};

const monthLabels = weeks.map((week, i) => {
  const month = mondayMonth(week);
  const prevMonth = i > 0 ? mondayMonth(weeks[i - 1]) : null;
  if (month === null || month === prevMonth) return null;
  return i === 0 ? month : month.slice(5);
});
---

<div class="overflow-x-auto">
  <div class="flex w-max gap-[3px]">
    <div class="flex shrink-0 flex-col gap-[3px]">
      <div class="size-3"></div>
      {
        Array.from({ length: 7 }, (_, dayIndex) => (
          <div class="text-muted-foreground flex size-3 items-center justify-end pr-1 text-[10px] leading-none">
            {WEEKDAY_LABEL[dayIndex] ?? ''}
          </div>
        ))
      }
    </div>
    {
      weeks.map((week, weekIndex) => (
        <div class="flex shrink-0 flex-col gap-[3px]">
          <div class="text-muted-foreground w-3 whitespace-nowrap text-[10px] leading-none">
            {monthLabels[weekIndex]}
          </div>
          {week.map((cell) => {
            if (!cell) return <span class="size-3" />;
            const isNoted = noted.has(cell.date);
            const classes = [
              'block size-3 rounded-[2px]',
              LEVEL[level(cell.total)],
              isNoted
                ? 'ring-1 ring-foreground ring-offset-1 ring-offset-background'
                : '',
            ]
              .filter(Boolean)
              .join(' ');
            return cell.total > 0 ? (
              <a
                href={`/day/${cell.date}`}
                data-date={cell.date}
                data-noted={isNoted}
                aria-label={`${cell.date}，${cell.total} 則`}
                class={classes}
              />
            ) : (
              <span
                data-date={cell.date}
                data-noted={isNoted}
                aria-label={cell.date}
                class={classes}
              />
            );
          })}
        </div>
      ))
    }
  </div>
</div>

<div class="text-muted-foreground mt-3 flex items-center gap-2 text-xs">
  <span>少</span>
  {LEVEL.map((cls) => <span class={`size-3 rounded-[2px] ${cls}`} />)}
  <span>多</span>
  <span
    class="ring-foreground ring-offset-background bg-muted ml-3 size-3 rounded-[2px] ring-1 ring-offset-1"
  ></span>
  <span>已寫回憶</span>
</div>
