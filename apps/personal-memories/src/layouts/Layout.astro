---
import '../styles/global.css';

import { AppBar } from '../components/chrome/AppBar.tsx';
import type { Level, Place } from '../lib/nav.ts';
import { revealScript } from '../lib/reveal.ts';
import { HIDDEN_KEY, SOURCES } from '../lib/sources.ts';

type Props = {
  title: string;
  wide?: boolean;
  bar?:
    | {
        place: Place;
        hrefs: Record<Level, string>;
        step?: { prev?: string | undefined; next?: string | undefined };
      }
    | undefined;
};

const { title, wide = false, bar } = Astro.props;
---

<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline set:html={revealScript()} />
    <script
      is:inline
      define:vars={{ key: HIDDEN_KEY, sources: SOURCES.map((s) => s.source) }}
    >
      // Module scripts run after first paint, so hidden sources would flash in; this one blocks.
      try {
        const hidden = JSON.parse(localStorage.getItem(key) ?? '[]');
        if (Array.isArray(hidden))
          for (const source of hidden)
            if (typeof source === 'string' && sources.includes(source))
              document.documentElement.setAttribute('data-hide-' + source, '');
      } catch {}
    </script>
  </head>
  <body class="antialiased">
    <main class:list={['mx-auto px-4 py-8', wide ? 'max-w-6xl' : 'max-w-2xl']}>
      {
        bar && (
          <AppBar
            client:load
            place={bar.place}
            hrefs={bar.hrefs}
            step={bar.step}
          />
        )
      }
      <slot />
    </main>
    <script>
      import {
        focusWithoutPreview,
        startPreviews,
      } from '../scripts/previews.ts';
      import { startShortcuts } from '../scripts/shortcuts.ts';
      import { startZoom } from '../scripts/zoom.ts';
      startShortcuts();
      startZoom(focusWithoutPreview);
      startPreviews();
    </script>
  </body>
</html>
