---
import '../styles/global.css';

import { AppBar } from '../components/chrome/AppBar.tsx';
import type { Level, Place } from '../lib/nav.ts';

type Props = {
  title: string;
  wide?: boolean;
  bar?:
    | {
        place: Place;
        hrefs: Record<Level, string>;
        step?: { prev?: string | undefined; next?: string | undefined };
      }
    | undefined;
};

const { title, wide = false, bar } = Astro.props;
---

<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      // pagereveal fires before deferred or module scripts can listen, so this must be a blocking head script.
      function clearMorphNames() {
        for (const el of document.querySelectorAll('[data-morph]')) {
          el.style.viewTransitionName = '';
        }
      }
      window.addEventListener('pagereveal', (event) => {
        (event.viewTransition?.finished ?? Promise.resolve()).finally(
          clearMorphNames,
        );
      });
      window.addEventListener('pageshow', (event) => {
        if (event.persisted) clearMorphNames();
      });
    </script>
  </head>
  <body class="antialiased">
    <main class:list={['mx-auto px-4 py-8', wide ? 'max-w-6xl' : 'max-w-2xl']}>
      {
        bar && (
          <AppBar
            client:load
            place={bar.place}
            hrefs={bar.hrefs}
            step={bar.step}
          />
        )
      }
      <slot />
    </main>
    <script>
      import { startShortcuts } from '../scripts/shortcuts.ts';
      import { startZoom } from '../scripts/zoom.ts';
      startShortcuts();
      startZoom();
    </script>
  </body>
</html>
