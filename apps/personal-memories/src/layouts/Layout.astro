---
import '../styles/global.css';

type Props = { title: string };

const { title } = Astro.props;
---

<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <main class="mx-auto max-w-2xl px-4 py-8">
      <slot />
    </main>
  </body>
</html>
