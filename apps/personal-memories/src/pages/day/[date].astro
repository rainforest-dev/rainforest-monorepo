---
import { Alert, AlertDescription } from '@rainforest-dev/rainforest-react';
import { getLiveEntry } from 'astro:content';

import DaySection from '@/components/DaySection.astro';
import { MonthScrubber } from '@/components/day/MonthScrubber.tsx';
import Sentinel from '@/components/day/Sentinel.astro';
import { SourceFilter } from '@/components/day/SourceFilter.tsx';
import { StreamMenu } from '@/components/day/StreamMenu.tsx';
import EmptyState from '@/components/EmptyState.astro';
import { NotePanel } from '@/components/NotePanel.tsx';
import { OrbPicker } from '@/components/orbs/OrbPicker.tsx';
import YearStrip from '@/components/orbs/YearStrip.astro';
import Layout from '@/layouts/Layout.astro';
import {
  authorAccents,
  dayHeading,
  dayKey,
  heatLevels,
  isCoverCandidate,
  levelHrefs,
  morphFromRequest,
  nearestDate,
  type OrbEntry,
  photoKey,
  scrubberMonths,
  summarize,
  taipeiTime,
  thumbUrl,
} from '@/lib';
import { viewerName } from '@/lib/notes';
import {
  getDayIndex,
  getPeople,
  getTimeline,
  isInsideOut,
  notePayload,
  notesStore,
  orbContext,
  orbsStore,
  publicPeople,
} from '@/lib/server';

const { date = '' } = Astro.params;
const morph = morphFromRequest(Astro.request, Astro.url);
const [state, people] = await Promise.all([getTimeline(), getPeople()]);
const roster = publicPeople(people);
const { entry } =
  state.status === 'ready'
    ? await getLiveEntry('days', { date })
    : { entry: undefined };
const day = entry?.data;
if (state.status === 'ready' && !day?.events) Astro.response.status = 404;
const initial = day?.events
  ? notePayload(
      notesStore(),
      date,
      day.events,
      viewerName(Astro.request.headers, people.people),
      roster,
    )
  : undefined;

const index = await getDayIndex();
const dates = index?.dates ?? [];
const accents =
  state.status === 'ready'
    ? Object.fromEntries(
        authorAccents(state.timeline.events, people.owners, roster),
      )
    : {};
const months = index ? scrubberMonths(summarize(index)) : [];
const nearest = !day?.events ? nearestDate(dates, date) : undefined;
const jumped = Astro.url.searchParams.has('nearest') && !!day?.events;
const insideOut = isInsideOut();
const orbs = insideOut ? await orbContext(Astro.request.headers) : undefined;
const yearTotals = new Map(
  (index?.dates ?? [])
    .filter((d) => d.startsWith(date.slice(0, 4)))
    .map((d) => [d, index?.byDate.get(d)?.length ?? 0]),
);
const orbTargets = day?.events
  ? [
      { key: dayKey(date), label: '這一整天' },
      ...day.events
        .filter(isCoverCandidate)
        .slice(0, 80)
        .map((e) => ({
          key: photoKey(e.id),
          label: `${taipeiTime(e.at)} 的照片`,
          thumb: thumbUrl(e.id, 0, 240),
        })),
    ]
  : [];
const orbInitial: Record<string, OrbEntry> = Object.fromEntries(
  orbTargets.flatMap((t) => {
    const entry = orbs?.file.orbs[t.key];
    return entry ? [[t.key, entry]] : [];
  }),
);
const bar = {
  place: { level: 'day' as const, date },
  hrefs: levelHrefs({ level: 'day', date }, dates),
  step: { prev: day?.prev, next: day?.next },
};
---

<Layout title={`${date} · Memories`} wide bar={bar}>
  {
    state.status === 'missing' ? (
      <EmptyState path={state.path} />
    ) : !day?.events || !initial ? (
      <p>
        找不到 {date} 這一天。
        {nearest && (
          <a class="underline" href={`/day/${nearest}`}>
            {dayHeading(nearest)}
          </a>
        )}
      </p>
    ) : (
      <>
        {jumped && (
          <Alert variant="info" className="mb-4">
            <AlertDescription>
              沒有這一天，已跳到最近的 {dayHeading(date)}
            </AlertDescription>
          </Alert>
        )}
        {orbs && (
          <YearStrip
            year={date.slice(0, 4)}
            current={date}
            totals={yearTotals}
            level={heatLevels([...yearTotals.values()])}
            orbs={orbs.file}
            ids={orbs.pair.map((p) => p.id)}
          />
        )}
        <div class="lg:grid lg:grid-cols-[56px_minmax(0,1fr)_400px] lg:gap-8">
          <aside class="hidden lg:sticky lg:top-[calc(var(--app-bar-h)+1rem)] lg:block lg:max-h-[calc(100vh-var(--app-bar-h)-2rem)]">
            <MonthScrubber client:idle months={months} date={date} />
          </aside>
          <div data-stream class="pb-[172px] lg:pb-0">
            <div class="mb-4">
              <SourceFilter client:load />
            </div>
            <Sentinel direction="prev" date={day.prev} />
            <DaySection
              date={date}
              events={day.events}
              prev={day.prev}
              next={day.next}
              morph={morph}
            />
            <Sentinel direction="next" date={day.next} />
          </div>
          <NotePanel client:load initial={initial} accents={accents} />
          <StreamMenu client:idle />
          {orbs && (
            <OrbPicker
              client:load
              title={`${dayHeading(date)}的記憶球`}
              pair={orbs.pair}
              viewer={orbs.viewer}
              writable={!!orbsStore()?.writable}
              targets={orbTargets}
              initial={orbInitial}
            />
          )}
        </div>
      </>
    )
  }
</Layout>

<script>
  import { startDayStream } from '@/scripts/day-stream.ts';
  startDayStream();
</script>
