---
import { dayForWeek, indexDays } from '@/lib';
import { getTimeline } from '@/lib/server';

const { isoWeek = '' } = Astro.params;
const state = await getTimeline();
const day =
  state.status === 'ready'
    ? dayForWeek(indexDays(state.timeline.events), isoWeek)
    : undefined;
if (day) return Astro.redirect(`/day/${day}`, 301);
return new Response('Not found', { status: 404 });
---
