{
  "name": "@rainforest-monorepo/personal-memories",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 3004 --host 127.0.0.1",
    "build": "astro check && astro build",
    "preview": "astro preview --port 3004 --host 127.0.0.1",
    "ingest": "node src/cli/ingest.ts",
    "auto-import": "node src/cli/auto-import.ts",
    "fixture": "node src/cli/fixture.ts",
    "docker-smoke": "node src/cli/docker-smoke.ts"
  },
  "nx": {
    "name": "personal-memories",
    "projectType": "application",
    "sourceRoot": "apps/personal-memories/src",
    "tags": [
      "docker"
    ],
    "targets": {
      "dev": {
        "dependsOn": [
          "^build"
        ]
      },
      "build": {
        "dependsOn": [
          "^build"
        ],
        "cache": true
      },
      "typecheck": {
        "dependsOn": [
          "^build"
        ],
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "cwd": "apps/personal-memories",
          "command": "tsc --noEmit -p tsconfig.json"
        }
      },
      "bundle": {
        "command": "node tools/app-artifact/bundle.mjs astro apps/personal-memories"
      },
      "smoke-artifact": {
        "command": "node tools/app-artifact/smoke.mjs personal-memories"
      }
    },
    "release": {
      "docker": {
        "repositoryName": "rainforest-dev/personal-memories"
      }
    }
  },
  "dependencies": {
    "@astrojs/node": "^11.1.11",
    "@astrojs/react": "^7.1.4",
    "@rainforest-dev/journal-kit": "workspace:*",
    "@rainforest-dev/mcp-kit": "workspace:*",
    "@rainforest-dev/rainforest-react": "workspace:*",
    "@rainforest-dev/rainforest-ui": "workspace:*",
    "@rainforest-dev/search": "workspace:*",
    "@rainforest-dev/web-ai": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "5.107.1",
    "astro": "^7.4.7",
    "lucide-react": "^1.70.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "^0.35.5",
    "tailwindcss": "catalog:",
    "tslib": "^2.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vercel/nft": "^1.11.1",
    "typescript": "catalog:",
    "vitest": "^5.1.0"
  }
}
