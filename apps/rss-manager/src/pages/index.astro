---
import { RegistryDesk } from '@/components/RegistryDesk.tsx';
import { parseDeskParams } from '@/lib/desk';
import { QUEUE_FILE, readDeskData, SOURCES_FILE, TOPICS_FILE } from '@/server';
import '@/styles/global.css';

const params = parseDeskParams(Astro.url.searchParams);
const data = readDeskData();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RSS Manager — Rainforest Tools</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="min-h-screen">
    <RegistryDesk
      client:load
      initialParams={params}
      data={data}
      files={{ sources: SOURCES_FILE, topics: TOPICS_FILE, queue: QUEUE_FILE }}
    />
  </body>
</html>
