{
  "name": "@rainforest-monorepo/rss-manager",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 3002 --host 0.0.0.0",
    "build": "astro check && astro build",
    "preview": "astro preview --port 3002"
  },
  "nx": {
    "tags": [
      "docker"
    ],
    "targets": {
      "dev": {
        "dependsOn": [
          "^build"
        ]
      },
      "build": {
        "dependsOn": [
          "^build"
        ],
        "cache": true
      },
      "bundle": {
        "command": "node tools/app-artifact/bundle.mjs astro apps/rss-manager"
      },
      "smoke-artifact": {
        "command": "node tools/app-artifact/smoke.mjs rss-manager"
      }
    },
    "release": {
      "docker": {
        "repositoryName": "rainforest-dev/rss-manager"
      }
    }
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "^7.0.1",
    "@rainforest-dev/rainforest-react": "workspace:*",
    "@rainforest-dev/rainforest-ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "astro": "^7.3.8",
    "lucide-react": "^1.55.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vercel/nft": "^1.11.0",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  }
}
