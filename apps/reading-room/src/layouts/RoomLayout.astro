---
import {
  type CollectionId,
  HTML_LANG,
  pageTitle,
} from '@rainforest-dev/library-contract';
import {
  SHELL_ASSETS,
  sidebarScript,
  speculationRulesJson,
} from '@rainforest-dev/library-shell';

import {
  RoomHeader,
  type RoomSections,
} from '@/components/shell/RoomHeader.tsx';
import { KB_SOURCES, type KbSource, kbSourceLabel } from '@/lib/kb';
import { KB_PATH, RACK_PATH, SOURCES_PATH } from '@/lib/paths';
import { roomT } from '@/locales';
import { showsCollections } from '@/server';
import '@/styles/global.css';

interface Props {
  /** The page within its collection; a collection's front page leaves it out. */
  title?: string;
  collection: CollectionId;
  /** The current page among the collection's sections: `rack` or `sources`, or a KB source. */
  section?: string;
  /** Each knowledge-base source's page count, shown on its section. */
  kbCounts?: Record<KbSource, number>;
}

const { title, collection, section, kbCounts } = Astro.props;
const collections = showsCollections(Astro.url);
const { locale } = Astro.locals;
const t = roomT(locale);
const sections: RoomSections | undefined =
  collection === 'rack'
    ? {
        label: t('header.sections'),
        current: section,
        items: [
          { id: 'rack', label: t('header.rack'), href: RACK_PATH },
          { id: 'sources', label: t('header.sources'), href: SOURCES_PATH },
        ],
      }
    : collection === 'kb' && kbCounts
      ? {
          label: t('kb.sources'),
          current: section,
          items: KB_SOURCES.map((s) => ({
            id: s,
            label: `${kbSourceLabel(s, t)} ${kbCounts[s]}`,
            href: `${KB_PATH}?source=${s}`,
          })),
        }
      : undefined;
---

<!doctype html>
<html lang={HTML_LANG[locale]} class="font-sans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle(locale, collection, title)}</title>
    <link rel="icon" href={SHELL_ASSETS.icon} type="image/svg+xml" />
    <link
      rel="preload"
      href={SHELL_ASSETS.fonts[0]}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href={SHELL_ASSETS.stylesheet} />
    <script is:inline set:html={sidebarScript()} />
    <script
      is:inline
      type="speculationrules"
      set:html={speculationRulesJson()}
    />
  </head>
  <body
    class:list={[
      'min-h-screen',
      // Room for the phone tab bar, which floating bars read to sit above it.
      collections &&
        'pb-16 [--library-tab-bar:4rem] sm:pb-0 sm:[--library-tab-bar:0px]',
    ]}
  >
    <RoomHeader
      client:idle
      locale={locale}
      collection={collection}
      sections={sections}
      collections={collections}
    />
    <slot />
  </body>
</html>
