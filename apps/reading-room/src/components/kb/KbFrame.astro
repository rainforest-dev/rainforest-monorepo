---
import { SHELL_IDS } from '@rainforest-dev/library-shell';

import { type KbShelf, type KbSource } from '@/lib/kb';
import { roomT } from '@/locales';

import KbNav from './KbNav.astro';

interface Props {
  source: KbSource;
  shelves: KbShelf[];
  currentId?: string;
  /** Whether the page has a related-content column. */
  aside?: boolean;
}

const { aside = false, ...nav } = Astro.props;
const t = roomT(Astro.locals.locale);
const SIDE =
  'lg:sticky lg:top-(--library-top) lg:h-[calc(100dvh-var(--library-top))] lg:overflow-y-auto';
---

<div
  class:list={[
    'grid grid-cols-1',
    // The related column sits under the article until `xl`, then beside it. Widths are the
    // shell's; a closed sidebar drops its track.
    'lg:sidebar-closed:grid-cols-[minmax(0,1fr)] lg:grid-cols-[var(--library-sidebar)_minmax(0,1fr)]',
    aside &&
      'xl:sidebar-closed:grid-cols-[minmax(0,1fr)_var(--library-aside)] xl:grid-cols-[var(--library-sidebar)_minmax(0,1fr)_var(--library-aside)]',
  ]}
>
  <div
    id={SHELL_IDS.sidebar}
    class:list={[
      'bg-muted/40 lg:sidebar-closed:hidden hidden border-r lg:block',
      SIDE,
    ]}
  >
    <KbNav {...nav} />
  </div>
  <div class="min-w-0">
    <details class="bg-muted/40 border-b lg:hidden">
      <summary
        class="flex min-h-11 cursor-pointer items-center px-4 text-sm font-semibold"
      >
        {t('kb.toc')}
      </summary>
      <div class="max-h-[60dvh] overflow-y-auto border-t">
        <KbNav {...nav} />
      </div>
    </details>
    <slot />
  </div>
  {
    aside && (
      <aside
        aria-label={t('kb.related')}
        class:list={[
          'lg:sidebar-closed:col-start-1 xl:sidebar-closed:col-start-auto border-t p-5 lg:col-start-2 xl:col-start-auto xl:border-l xl:border-t-0',
          'xl:top-(--library-top) xl:sticky xl:h-[calc(100dvh-var(--library-top))] xl:overflow-y-auto',
        ]}
      >
        <slot name="aside" />
      </aside>
    )
  }
</div>
