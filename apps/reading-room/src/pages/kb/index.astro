---
import {
  Badge,
  Empty,
  EmptyDescription,
  EmptyHeader,
  EmptyTitle,
} from '@rainforest-dev/rainforest-react';

import KbFrame from '@/components/kb/KbFrame.astro';
import RoomLayout from '@/layouts/RoomLayout.astro';
import {
  KB_SOURCE_LABELS,
  kbCounts,
  kbShelves,
  parseKbSource,
  searchKb,
} from '@/lib/kb';
import { KB_PATH } from '@/lib/paths';
import { getKbIndex } from '@/server';

const params = Astro.url.searchParams;
const source = parseKbSource(params.get('source'));
const shelfId = params.get('shelf') ?? undefined;
const q = (params.get('q') ?? '').trim();

const index = getKbIndex();
const shelves = kbShelves(index.docs, source);
const shown = shelfId ? shelves.filter((s) => s.id === shelfId) : shelves;
const hits = q ? searchKb(index.entries, q) : [];
const mounted = index.mounted[source];
---

<RoomLayout title="知識庫" collection="kb">
  <KbFrame source={source} counts={kbCounts(index.docs)} shelves={shelves}>
    <main class="flex flex-col gap-6 px-4 py-6 sm:px-8 lg:px-14 lg:py-8">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h2 class="text-xl font-semibold">知識庫</h2>
        <p class="text-muted-foreground text-sm">
          vault 的 wiki 與 Readwise 摘錄，唯讀
        </p>
      </div>
      <form
        method="get"
        action={KB_PATH}
        role="search"
        class="flex max-w-xl gap-2"
      >
        <label for="kb-q" class="sr-only">搜尋知識庫</label>
        <input
          id="kb-q"
          name="q"
          type="search"
          value={q}
          placeholder="搜尋 wiki 與 Readwise"
          class="bg-background focus-visible:ring-ring h-10 min-w-0 flex-1 rounded-md border px-3 text-sm outline-none focus-visible:ring-2"
        />
        <input type="hidden" name="source" value={source} />
        <button
          type="submit"
          class="bg-primary text-primary-foreground h-10 rounded-md px-4 text-sm font-medium"
        >
          搜尋
        </button>
      </form>

      {
        q ? (
          <section aria-labelledby="kb-results">
            <h3 id="kb-results" class="text-muted-foreground mb-3 text-sm">
              「{q}」· {hits.length} 筆
            </h3>
            {hits.length === 0 ? (
              <p class="text-muted-foreground text-sm">沒有符合的頁面。</p>
            ) : (
              <ul class="flex max-w-3xl flex-col divide-y">
                {hits.map(({ doc, snippet }) => (
                  <li>
                    <a
                      href={doc.href}
                      class="hover:bg-accent/60 -mx-2 block rounded-md px-2 py-3"
                    >
                      <span class="flex items-center gap-2">
                        <Badge variant="secondary">
                          {KB_SOURCE_LABELS[doc.source]}
                        </Badge>
                        <span class="font-semibold">{doc.title}</span>
                      </span>
                      <span class="text-muted-foreground mt-1 block text-sm">
                        {snippet}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ) : !mounted ? (
          <Empty className="border py-12">
            <EmptyHeader>
              <EmptyTitle>{KB_SOURCE_LABELS[source]} 還沒有掛載</EmptyTitle>
              <EmptyDescription>
                容器裡找不到這個資料夾；homelab 的唯讀掛載設定好之後就會出現。
              </EmptyDescription>
            </EmptyHeader>
          </Empty>
        ) : shown.length === 0 ? (
          <Empty className="border py-12">
            <EmptyHeader>
              <EmptyTitle>這個書櫃是空的</EmptyTitle>
              <EmptyDescription>沒有可以顯示的頁面。</EmptyDescription>
            </EmptyHeader>
          </Empty>
        ) : (
          shown.map((shelf) => (
            <section aria-labelledby={`kb-main-${shelf.id}`}>
              <h3 id={`kb-main-${shelf.id}`} class="mb-3 text-sm font-semibold">
                {shelf.label}
                <span class="text-muted-foreground font-normal">
                  {' '}
                  · {shelf.docs.length}
                </span>
              </h3>
              <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2 2xl:grid-cols-3">
                {shelf.docs.map((doc) => (
                  <li class="flex">
                    <a
                      href={doc.href}
                      class="bg-card hover:bg-accent focus-visible:ring-ring border-t-chart-3 flex w-full flex-col gap-1 rounded-md border border-t-4 p-3 outline-none focus-visible:ring-2"
                    >
                      <span class="font-semibold leading-snug">
                        {doc.title}
                      </span>
                      <span class="text-muted-foreground text-xs">
                        {[doc.tags[0], doc.status, doc.author, doc.updated]
                          .filter(Boolean)
                          .join(' · ')}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        )
      }
    </main>
  </KbFrame>
</RoomLayout>
