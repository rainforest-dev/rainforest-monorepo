---
import { collectionForPath } from '@rainforest-dev/library-contract';

import { RoomNotFound } from '@/components/shell/RoomNotFound.tsx';
import RoomLayout from '@/layouts/RoomLayout.astro';

// The rack, its magazines and the knowledge base are the collections this app serves.
const own = collectionForPath(Astro.url.pathname).id;
const collection = own === 'kb' || own === 'magazines' ? own : 'rack';
Astro.response.status = 404;
---

<RoomLayout collection={collection}>
  <main class="px-4 pt-6 lg:px-6">
    <RoomNotFound locale={Astro.locals.locale} collection={collection} />
  </main>
</RoomLayout>
