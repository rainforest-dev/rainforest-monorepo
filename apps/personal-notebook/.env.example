# Everything the app writes: notebook.db, pages/ and search/.
NOTEBOOK_DATA_DIR=/path/to/notebook-data
# Optional: a personal-calibre data folder to copy notebooks from on the first start.
# NOTEBOOK_IMPORT_FROM=/path/to/calibre-app-data
# Optional: the /api/inbox/bujo secret (x-inbox-secret) and the /mcp gateway secret
# (x-notebook-gateway). Each endpoint answers 404 while its secret is unset.
# NOTEBOOK_INBOX_SECRET=
# NOTEBOOK_MCP_SECRET=
# Optional: Ollama for semantic page search and OCR. NOTEBOOK_EMBED=fake for tests.
# NOTEBOOK_OLLAMA_URL=http://localhost:11434
# NOTEBOOK_EMBED_MODEL=
# NOTEBOOK_OCR_MODEL=qwen3-vl:8b-instruct
# NOTEBOOK_OCR_INTERVAL_MS=
