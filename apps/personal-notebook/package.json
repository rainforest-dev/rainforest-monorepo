{
  "name": "@rainforest-monorepo/personal-notebook",
  "version": "0.0.1",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@rainforest-dev/journal-kit": "workspace:*",
    "@rainforest-dev/library-contract": "workspace:*",
    "@rainforest-dev/library-shell": "workspace:*",
    "@rainforest-dev/mcp-kit": "workspace:*",
    "@rainforest-dev/notebook-tools": "workspace:*",
    "@rainforest-dev/rainforest-react": "workspace:*",
    "@rainforest-dev/rainforest-ui": "workspace:*",
    "@rainforest-dev/search": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "heic-decode": "^2.1.0",
    "lucide-react": "^1.61.0",
    "next": "catalog:",
    "pdf-lib": "1.17.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "^0.35.5",
    "tailwind-merge": "catalog:",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "nx": {
    "name": "personal-notebook",
    "projectType": "application",
    "sourceRoot": "apps/personal-notebook/src",
    "tags": [
      "docker"
    ],
    "targets": {
      "dev": {
        "options": {
          "port": 8086
        },
        "dependsOn": [
          "^build",
          "shell-assets"
        ]
      },
      "build": {
        "outputs": [
          "{projectRoot}/.next/!(cache)/**/*",
          "{projectRoot}/.next/!(cache)"
        ],
        "dependsOn": [
          "^build",
          "shell-assets"
        ]
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/personal-notebook",
          "command": "tsc --noEmit -p tsconfig.json"
        },
        "dependsOn": [
          "^build"
        ]
      },
      "build-deps": {
        "executor": "nx:noop",
        "dependsOn": [
          "^build",
          "shell-assets"
        ]
      },
      "bundle": {
        "command": "node tools/app-artifact/bundle.mjs next apps/personal-notebook"
      },
      "smoke-artifact": {
        "command": "node tools/app-artifact/smoke.mjs personal-notebook"
      },
      "shell-assets": {
        "command": "node tools/library-shell/sync-assets.mjs apps/personal-notebook",
        "dependsOn": [
          {
            "projects": [
              "library-shell"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "{workspaceRoot}/tools/library-shell/sync-assets.mjs",
          {
            "dependentTasksOutputFiles": "**/_shell/**"
          }
        ],
        "outputs": [
          "{projectRoot}/public/_shell"
        ]
      }
    },
    "release": {
      "docker": {
        "repositoryName": "rainforest-dev/personal-notebook"
      }
    }
  }
}
