{
  "mcpServers": {
    "calibre-mcp": {
      "type": "http",
      "url": "http://localhost:8080/api/mcp",
      "headers": {
        "x-calibre-gateway": "${CALIBRE_MCP_SECRET:-}",
        "x-forwarded-login": "${USER:-local}"
      }
    },
    "next-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "Astro docs": {
      "type": "http",
      "url": "https://mcp.docs.astro.build/mcp"
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    }
  }
}
