<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>tools.rainforest.loop-ralph</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/rainforest/.claude/loop/ralph.sh</string>
    <!-- max_iter 1, budget 10, matching the mini. Fifteen iterations was the
         default this host inherited by passing no arguments at all, and the
         first enabled run spent 39 minutes on a task whose PR had merged three
         weeks earlier. One iteration per wake is what a second machine gets
         until its rows are trustworthy. These belong in config.yaml rather than
         a launchd unit; they are here because that is where the runner reads
         them today. -->
    <string>1</string>
    <string>10</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/rainforest/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LOOP_MACHINE</key>
    <string>rainforest-air</string>
    <key>LOOP_EXECUTORS</key>
    <string>claude,codex</string>
    <!-- Both emitted by deriveRalphPlist once this host's vaultPath fact is
         present, and both were missing while it was stale at null. Every preset
         in loop-agents.json is an AG-* ticket, so this is the one machine that
         needs the file, and without the variable ralph fell to the executor
         default and ignored all eleven, saying nothing. -->
    <key>LOOP_AGENT_CONFIG</key>
    <string>/Users/rainforest/Library/Mobile Documents/iCloud~md~obsidian/Documents/rainforest-obsidian/_system/usage/loop-agents.json</string>
    <key>LOOP_QUOTA_FILE</key>
    <string>/Users/rainforest/Library/Mobile Documents/iCloud~md~obsidian/Documents/rainforest-obsidian/_system/usage/quota.rainforest-air.json</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/Users/rainforest/.claude/loop/ralph.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/rainforest/.claude/loop/ralph.err.log</string>
</dict>
</plist>
