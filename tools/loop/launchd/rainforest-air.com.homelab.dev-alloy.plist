<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DEV_EVENTS_SPOOL</key>
		<string>/Users/rainforest/.local/state/dev-telemetry/events.jsonl</string>
		<key>LOKI_PUSH_URL</key>
		<string>http://raspberrypi-5:30100/loki/api/v1/push</string>
		<key>PROMETHEUS_REMOTE_WRITE_URL</key>
		<string>http://raspberrypi-5:30090/api/v1/write</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.homelab.dev-alloy</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>5</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<!-- The directory form is required, not the single config.alloy file: the
	     loop's OTLP intake ships as a separate loop-otlp.alloy fragment beside
	     the hand-maintained config.alloy, and alloy's own run subcommand help
	     documents that when the given path is a directory, every *.alloy file
	     in it is combined into a single unit. Pointing at config.alloy alone
	     would load only the hand-maintained definitions and silently drop the
	     fragment. -->
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/alloy</string>
		<string>run</string>
		<string>--server.http.listen-addr=127.0.0.1:12345</string>
		<string>--storage.path=/Users/rainforest/.local/state/dev-telemetry/alloy</string>
		<string>/Users/rainforest/.config/dev-telemetry/alloy</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/rainforest/Library/Logs/dev-alloy.log</string>
	<key>StandardOutPath</key>
	<string>/Users/rainforest/Library/Logs/dev-alloy.log</string>
</dict>
</plist>
